PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/autana_dev
# Genera un valor propio de al menos 32 caracteres, por ejemplo con: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Origen de la API, sin ruta. Debe coincidir con PORT.
BETTER_AUTH_URL=http://localhost:3000

# Origen del frontend (opcional)
WEB_ORIGIN=http://localhost:5173

# Pon true solo detrás de un proxy inverso que añada la IP del cliente a X-Forwarded-For (límite de peticiones)
TRUST_PROXY=false
