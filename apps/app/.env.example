# Destino del proxy de Vite en desarrollo (opcional). Debe coincidir con el origen de la API; por defecto http://localhost:3000.
API_PROXY_TARGET=http://localhost:3000

# Origen de la API para el frontend (opcional). Déjalo vacío si el frontend y la API comparten origen, como en desarrollo
# con el proxy de Vite. Con la API en otro origen del mismo sitio, por ejemplo https://api.example.com, indícalo aquí.
VITE_API_URL=
