# Fallback de la SPA: las rutas de React Router se resuelven en el cliente, así que cualquier ruta
# que no sea un archivo o directorio real devuelve index.html.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
