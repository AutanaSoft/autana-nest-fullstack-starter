{
  "name": "autana-nest-fullstack-starter",
  "version": "0.0.1",
  "private": true,
  "description": "Base mínima full stack (API con NestJS, frontend con React y PostgreSQL) para iniciar nuevos proyectos.",
  "keywords": [
    "starter",
    "template",
    "full-stack",
    "monorepo",
    "nestjs",
    "react",
    "vite",
    "drizzle",
    "postgresql",
    "typescript"
  ],
  "homepage": "https://github.com/AutanaSoft/autana-nest-fullstack-starter#readme",
  "bugs": {
    "url": "https://github.com/AutanaSoft/autana-nest-fullstack-starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AutanaSoft/autana-nest-fullstack-starter.git"
  },
  "license": "MIT",
  "author": {
    "name": "AutanaSoft",
    "url": "https://autanasoft.com"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "prepare": "husky",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "check": "prettier --check . && turbo lint typecheck && npm run lint:md",
    "test": "turbo test",
    "db:generate": "npm run db:generate -w @autana/database",
    "db:migrate": "npm run db:migrate -w @autana/database",
    "db:reset": "npm run db:reset -w @autana/database"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "markdownlint-cli2": "^0.24.2",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.11",
    "typescript": "~6.0.2"
  },
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true
  }
}
